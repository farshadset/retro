NODE_ENV=production
PORT=3000
WEB_CONCURRENCY=1

# Store mode
# memory = current implementation (single instance only)
# redis  = reserved for next scale phase after redis-backed room store is implemented
CHESS_STORE_MODE=memory
CHESS_ENFORCE_SINGLE_INSTANCE=true

# Optional runtime tuning
CHESS_ROOM_STORE_MAX_ROOMS=500
CHESS_ROOM_STORE_TTL_MS=21600000

# Reserved for next phase (do not set in current deployment mode)
# REDIS_URL=redis://user:password@host:6379/0
