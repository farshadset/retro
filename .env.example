NODE_ENV=production
PORT=3000
NEXT_PUBLIC_CHESS_API_BASE_URL=https://your-domain.ir

# Go chess backend store mode
CHESS_STORE_MODE=memory

# Optional runtime tuning
CHESS_ROOM_STORE_MAX_ROOMS=500
CHESS_ROOM_STORE_TTL_MS=21600000

# Go realtime backend
GO_CHESS_PORT=4000

# Reserved for next phase (redis mode is not implemented yet)
# REDIS_URL=redis://user:password@host:6379/0
